generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A LINE user. Identity is verified server-side via the LINE access token.
model User {
  id            String   @id @default(cuid())
  lineUserId    String   @unique
  displayName   String
  pictureUrl    String?
  userName      String   @default("") // name chosen during onboarding
  onboarded     Boolean  @default(false)
  tutorialDone  Boolean  @default(false)
  activeGroupId String? // clientId of the active group
  avatar        Bytes? // uploaded avatar image (served via /api/avatar/[id])
  avatarMime    String? // content-type of the uploaded avatar
  avatarVersion Int      @default(0) // bumped on each upload; 0 = no custom avatar
  createdAt     DateTime @default(now())
  groups        Group[] // groups this user created
  members       Member[] // member slots this user occupies across groups
  joinRequests  JoinRequest[]
}

// A splitting group ("帳本/群組"). Owned by one LINE user.
model Group {
  id         String    @id @default(cuid())
  clientId   String // frontend-generated id, stable & unique per creator
  name       String
  usePool    Boolean   @default(false)
  isDemo     Boolean   @default(false)
  pool       Int       @default(0)
  position   Int       @default(0) // preserve creation order
  inviteCode String?   @unique // share-link token; null until first invite
  userId     String // creator
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  members    Member[]
  expenses   Expense[]
  requests   JoinRequest[]

  @@unique([userId, clientId])
}

// A pending request to join a group via invite link; the group admin
// (creator) approves or rejects. One open request per user per group.
model JoinRequest {
  id            String   @id @default(cuid())
  groupId       String
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requesterName String // the requester's LINE display name
  claimMemberId String? // member slot they want to claim (null = join as new)
  newName       String? // chosen name when joining as a new member
  createdAt     DateTime @default(now())

  @@unique([groupId, userId])
}

// A label within a group (e.g. "Jerry"). Not a real account.
model Member {
  id       String  @id @default(cuid())
  clientId String // frontend id ("me", "m_xxx"), referenced by payerId/splits
  name     String
  zh       String
  tone     Int
  isMe     Boolean @default(false) // creator-perspective flag; isMe is recomputed per viewer
  position Int     @default(0)
  groupId  String
  group    Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String? // the real LINE user occupying this slot (null = unclaimed label)
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([groupId, clientId])
  @@index([userId])
}

// A single expense, split among one or more members.
model Expense {
  id        String         @id @default(cuid())
  clientId  String // frontend id ("e_xxx")
  category  String
  note      String         @default("")
  amount    Int
  payerId      String // member clientId (informational when fromPool)
  fromPool     Boolean        @default(false) // paid from the shared fund (no personal debt)
  editedAt     DateTime? // last edit time
  editedByName String? // who last edited
  prevAmount   Int? // amount before the most recent edit
  at        DateTime // when the expense happened
  createdAt DateTime       @default(now())
  groupId   String
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  splits    ExpenseSplit[]

  @@unique([groupId, clientId])
}

// Join row: which member shares an expense.
model ExpenseSplit {
  id        String  @id @default(cuid())
  memberId  String // member clientId
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, memberId])
}
